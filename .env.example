NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/taskflow-pro?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Client URLs
FRONTEND_URL=http://localhost:5173
ADMIN_DASHBOARD_URL=http://localhost:5174
ANDROID_APP_URL=taskflowpro://auth
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000
# Production example:
# CORS_ORIGIN=https://admin-taskflow-pro.netlify.app,https://taskflow-ltd.netlify.app

# Auth policy
EMAIL_VERIFICATION_REQUIRED=false

# SMTP email delivery
# Leave SMTP_HOST / SMTP_USER / SMTP_PASS empty for local development if you want
# verification and reset links printed to the server logs instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TaskFlow Pro <no-reply@taskflowpro.com>"

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
